FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY tsconfig.base.json ./
COPY eslint.config.mjs ./
# train_station_mega_world.glb is gitignored (too large for git).
# The server redirects /assets/world/* to a CDN fallback when the file
# is absent locally, so the image builds and runs without it.
COPY packages ./packages
COPY apps/web ./apps/web
RUN npm install
RUN npm run -w @arena/shared build && npm run -w @arena/web build
EXPOSE 3000
CMD ["npm", "run", "-w", "@arena/web", "start"]
