{
  "name": "@arena/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run -w @arena/shared build",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run -w @arena/shared build",
    "start": "node dist/apps/server/src/index.js",
    "lint": "eslint src --ext .ts",
    "pretest": "npm run -w @arena/shared build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arena/shared": "0.1.0",
    "ethers": "^6.16.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "redis": "^4.7.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "end-of-stream": "^1.4.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
