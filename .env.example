# Shared
NODE_ENV=development
GAME_WS_AUTH_SECRET=
# Base Builder Code attribution (ERC-8021)
BUILDER_CODE=bc_uukadkll
# Optional explicit suffix override; when empty it is derived from BUILDER_CODE.
BUILDER_CODE_SUFFIX=
# Wallet encryption key - MUST be changed in production (generate with: openssl rand -hex 32)
WALLET_ENCRYPTION_KEY=

# Web
WEB_PORT=3000
WEB_API_BASE_URL=http://localhost:4000
WEB_AGENT_RUNTIME_BASE_URL=http://localhost:4100
PLAY_RUNTIME_V2_ENABLED=false
MOBILE_LAYOUT_V2_ENABLED=false
DIRECTIONING_V2_ENABLED=false
PUBLIC_WORLD_ASSET_BASE_URL=https://pub-302820e514cd451baaf272a33bd70765.r2.dev
ALLOWED_AUTH_ORIGINS=http://localhost:3000,https://autobett.netlify.app
WEB_STATE_FILE=output/web-auth-state.json
# Enables email/password auth via Firebase Identity Toolkit when set.
FIREBASE_WEB_API_KEY=
# Required for Firebase Google sign-in popup flow.
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_GOOGLE_AUTH_ENABLED=true
LOCAL_AUTH_ENABLED=false
# Set to true for local E2E testing — bypasses Firebase auth entirely. NEVER set in production.
DEV_BYPASS_AUTH=false
# Local admin auth is a dev-only escape hatch. Leave it disabled in prod.
# If enabled, set strong credentials (do not ship defaults).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAILS=

# Game Server
SERVER_PORT=4000
PROXIMITY_RADIUS=6
# CORS allowed origins (comma-separated). Required in production.
# Example: CORS_ALLOWED_ORIGINS=https://yourgame.com,https://www.yourgame.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4100
# LOCAL: redis://localhost:6379
# PRODUCTION (Fly.io): must use the Fly private URL — run `fly redis status arena-web-redis` to get it.
# WARNING: Do NOT use Railway or other external Redis URLs on Fly — their proxies close Fly connections.
#   Both arena-server and arena-web must point to the same Fly Upstash instance.
REDIS_URL=redis://localhost:6379
# Database connection with SSL required (production MUST use ?sslmode=require)
DATABASE_URL=postgresql://arena:arena@localhost:5432/arena?sslmode=prefer
# Set to web server base URL to enable WebSocket session validation (e.g. http://localhost:3000)
WEB_AUTH_URL=
SERVER_INSTANCE_ID=server_local_1
PRESENCE_TTL_SECONDS=40
PREDICTION_CHAINLINK_ENABLED=true
CHAINLINK_BTC_USD_FEED=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F
PREDICTION_CHAINLINK_DURATIONS=5m,24h
PREDICTION_CHAINLINK_RESOLUTION_GRACE_MS=15000
CHALLENGE_PENDING_TIMEOUT_MS=10000
CHALLENGE_ACTIVE_RESOLVE_MS=6000
CHALLENGE_ORPHAN_GRACE_MS=30000
ESCROW_EXECUTION_MODE=onchain
STATION_PLUGIN_ROUTER_ENABLED=false
DICE_DUEL_ENABLED=true
# Onchain escrow configuration (required)
# WARNING: Never commit real private keys. Use a secrets manager in production.
SEPOLIA_RPC_URL=
BASE_RPC_URL=https://mainnet.base.org
CHAIN_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=
ESCROW_RESOLVER_PRIVATE_KEY=
ESCROW_RESOLVER_ADDRESS=
ESCROW_CONTRACT_ADDRESS=0xc071a2a0da5901a8c036cc5d2d2d4ffc7b09787d
ESCROW_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# For Coinbase-sponsored approval flows, allowlist both ESCROW_CONTRACT_ADDRESS and ESCROW_TOKEN_ADDRESS in Paymaster.
ESCROW_FEE_RECIPIENT=
ESCROW_FEE_BPS=500
ESCROW_PRICE_FEED_ADDRESS=
CHAINLINK_BTC_USD_FEED=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F
ESCROW_TOKEN_DECIMALS=6
ESCROW_APPROVAL_MODE_SEPOLIA=auto
ESCROW_APPROVAL_MODE_MAINNET=manual
ESCROW_APPROVAL_MODE_DEFAULT=manual
ESCROW_APPROVAL_CHAIN_ID=
ESCROW_APPROVAL_CHAIN_HINT=
ESCROW_AUTO_APPROVE_MAX_WAGER=
ESCROW_AUTO_APPROVE_DAILY_CAP=
INTERNAL_SERVICE_TOKEN=
GAS_FUNDING_PRIVATE_KEY=
MIN_WALLET_GAS_ETH=0.0003
WALLET_GAS_TOPUP_ETH=0.001
WALLET_GAS_TOPUP_MAX_ETH=0.02
MAINNET_GAS_SPONSOR_ENABLED=false

# Agent Runtime
AGENT_RUNTIME_PORT=4100
BOT_COUNT=8
GAME_WS_URL=ws://localhost:4000/ws
GRAND_AGENT_ID=agent_1
AGENT_RUNTIME_STATE_FILE=output/agent-runtime-state.json
RUNTIME_DATABASE_URL=
USER_WALLET_AUTO_FLOOR=true
WALLET_PROVIDER_DEFAULT=internal

# LLM / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
MAX_REQUESTS_PER_HOUR_PER_AGENT=500
MAX_TOKENS_PER_DAY_PER_AGENT=2000000

# Wallet capability policy
WALLET_SKILLS_ENABLED=true
WALLET_SKILLS=authenticate-wallet,fund,send-usdc,trade,query-onchain-data,solidity-contract-design,solidity-security-review,evm-gas-optimization
MAX_BET_PERCENT_OF_BANKROLL=5
MAX_DAILY_TX_COUNT=24
REQUIRE_ESCROW_FOR_CHALLENGES=true

# Coinbase Developer Platform (CDP) — Embedded Wallets
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_PROJECT_ID=
# One-time USDC approval cap requested from Coinbase wallets for wagers/autoplay.
COINBASE_ESCROW_APPROVAL_CAP_USDC=25
